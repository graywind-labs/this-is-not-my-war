# Copy this file to .env for local development.
# Do not commit real API keys.

LLM_PROVIDER=mock
LLM_API_KEY=replace_with_your_local_api_key

# DeepSeek / OpenAI-compatible local backend mode.
# Keep real keys only in backend/.env or server environment variables.
# LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=30
LLM_FALLBACK_TO_MOCK=false
LLM_FORCE_JSON_RESPONSE=true
LLM_MAX_TOKENS=1200
LLM_TEMPERATURE=0.4

# Optional cost estimate in currency units per 1M tokens.
LLM_INPUT_COST_PER_M_TOKENS=0
LLM_OUTPUT_COST_PER_M_TOKENS=0

# Optional demo / production budget guards. 0 means disabled.
LLM_BUDGET_MAX_CALLS=0
LLM_BUDGET_MAX_INPUT_TOKENS=0
LLM_BUDGET_MAX_OUTPUT_TOKENS=0
LLM_BUDGET_MAX_TOTAL_TOKENS=0
LLM_BUDGET_MAX_COST=0
