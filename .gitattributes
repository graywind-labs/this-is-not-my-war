# Normalize line endings for text files across development machines.
* text=auto eol=lf

# Runtime art and audio are binary and should not bloat normal Git history.
assets/**/*.glb filter=lfs diff=lfs merge=lfs -text
assets/**/*.fbx filter=lfs diff=lfs merge=lfs -text
assets/**/*.png filter=lfs diff=lfs merge=lfs -text
assets/**/*.jpg filter=lfs diff=lfs merge=lfs -text
assets/**/*.webp filter=lfs diff=lfs merge=lfs -text
assets/**/*.wav filter=lfs diff=lfs merge=lfs -text
assets/**/*.ogg filter=lfs diff=lfs merge=lfs -text
