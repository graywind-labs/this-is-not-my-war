{
  "schema_version": "interaction_audio_v1",
  "ui": {
    "semantic_assets": {
      "primary": "sfx_ui_button_primary",
      "toggle": "sfx_ui_toggle",
      "success": "sfx_ui_interaction_success_resource_collect",
