  "intro_pages": [
    {
      "id": "intro_room",
      "speaker": "system",
      "speaker_name": "系统",
      "image": "res://assets/tutorial/lowpoly_v1/prologue_room_order.png",
      "text": "三年前，你被派到这座远离前线的驿站。直到最近，战争终于迫近了这里。"
    },
    {
      "id": "intro_order",
      "speaker": "order",
      "speaker_name": "军令",
      "image": "res://assets/tutorial/lowpoly_v1/prologue_sealed_order.png",
      "text": "“接到情报，敌军分队已绕过前线，疑将沿边境小路突袭。命边境各驿站守备官就地组织人手，确保驿站不失，等待后方援军。现有人手与物资皆由你调配。驿站若失，以弃守论处。”"
    },
    {
      "id": "intro_firelight",
      "speaker": "system",
      "speaker_name": "系统",
      "image": "res://assets/tutorial/lowpoly_v1/prologue_dormitory_sleep.png",
      "text": "当下没有增援，也没有正规军。这里只剩一座驿站，和八个本不该上战场的平民。"
    },
    {
      "id": "intro_ada_warning",
      "speaker": "ada",
      "speaker_name": "艾达",
      "image": "res://assets/tutorial/lowpoly_v1/prologue_ada_doorway.png",
      "text": "守备官！小路远处有火光出现，我确认了不是商队，是一小队敌人正在逼近！"
    },
    {
      "id": "intro_guard_question",
      "speaker": "player",
      "speaker_name": "守备官",
      "image": "res://assets/tutorial/lowpoly_v1/prologue_ada_doorway.png",
      "text": "站里还能组织多少人？"
    },
    {
      "id": "intro_ada_answer",
      "speaker": "ada",
      "speaker_name": "艾达",
      "image": "res://assets/tutorial/lowpoly_v1/prologue_ada_doorway_idle.png",
      "text": "卫兵都被抽去前线了。其他人还在宿舍睡觉——马夫、厨子、园丁、工匠。现在能立刻应战的，只有我。"
    },
    {
      "id": "intro_guard_order",
      "speaker": "player",
      "speaker_name": "守备官",
      "image": "res://assets/tutorial/lowpoly_v1/prologue_ada_doorway_idle.png",
      "text": "来不及了，只能硬拼了。"
    },
    {
      "id": "intro_ada_instruction",
      "speaker": "ada",
      "speaker_name": "艾达",
      "image": "res://assets/tutorial/lowpoly_v1/prologue_ada_doorway_idle.png",
      "text": "请守备官先把箭塔架上城墙，再给我一把武器。拉响警报后，我去门口殊死一搏！"
    }
  ],
  "post_battle_pages": [
    {"speaker": "ada", "speaker_name": "艾达", "text": "呼~ 只是几个探路的侦察兵。下一次不会这么少。"},
    {"speaker": "player", "speaker_name": "守备官", "text": "我们该怎么办？"},
    {"speaker": "ada", "speaker_name": "艾达", "text": "我们需要更多人手，我会去处理伤口。至于其他人——他们还没入伍，您得亲自和他们谈，让他们愿意参与防守而不是逃离驿站。"},
    {"speaker": "ada", "speaker_name": "艾达", "text": "只要还有人肯留在驿站，我们就还有希望。"},
    {"speaker": "system", "speaker_name": "系统", "text": "调配资源，说服成员应征入伍，安排生产和训练，打造装备、部署防线，并在敌袭后尽快治疗伤员。"}
  ]
