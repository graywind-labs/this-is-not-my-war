      "不让权力和信仰沦为残酷行为的借口"
    ],
    "fears": [
      "恐慌最终让人们彼此伤害",
      "自己的教会身份被拿去逼迫旁人服从",
      "掌权者用威胁、惩罚或礼物遮掩已经造成的伤害"
    ],
    "boundaries": [
