    "sample_seconds": 0.75,
    "minimum_progress": 0.08,
    "repath_after_samples": 2,
    "fail_after_seconds": 8.0,
    "maximum_repaths_per_target": 4
  },
  "authority_boundary": {
    "motion_component_owns": ["physical_velocity", "move_and_slide", "navigation_path", "avoidance_velocity", "stuck_detection"],
    "gameplay_systems_own": ["movement_intent", "destination", "arrival_effect", "location_commit", "workstation_reservation", "combat_target", "escape_completion"],
    "presentation_owns": ["animation", "facing_projection", "footstep_vfx", "selection_feedback"]
