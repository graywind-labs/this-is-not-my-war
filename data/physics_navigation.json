    "avoidance_priority_enemy": 0.55,
    "avoidance_layers": 1,
    "avoidance_mask": 1,
    "use_3d_avoidance": false
  },
  "path_progression": {
    "adaptive_waypoint_enabled": true,
    "maximum_intermediate_tolerance": 2.2,
    "shortcut_path_length_ratio": 1.05,
    "shortcut_path_length_margin": 0.15,
    "waypoint_advance_epsilon": 0.02,
    "reset_stale_avoidance_on_advance": true,
