  "navigation_agent": {
    "path_desired_distance": 0.35,
    "target_desired_distance": 0.25,
    "path_height_offset": 0.0,
    "avoidance_enabled": true,
    "avoidance_radius_padding": 0.1,
    "neighbor_distance": 3.5,
    "max_neighbors": 10,
    "time_horizon_agents": 0.9,
    "time_horizon_obstacles": 1.0,
