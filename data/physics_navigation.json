      "acceleration": 14.0
    },
    "enemy_foot": {
      "radius": 0.42,
      "height": 1.8,
      "step_height": 0.3,
      "max_slope_degrees": 45.0,
      "base_speed": 3.4,
      "acceleration": 12.0
    },
    "enemy_mounted": {
      "radius": 0.65,
      "height": 2.25,
      "step_height": 0.35,
