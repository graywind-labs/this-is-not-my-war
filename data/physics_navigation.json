  "navigation_mesh": {
    "production_cell_size": 0.25,
    "production_cell_height": 0.1,
    "agent_radius": 0.35,
    "baked_agent_radius": 0.5,
    "agent_height": 1.8,
    "agent_max_climb": 0.3,
    "agent_max_slope_degrees": 45.0,
    "source_geometry_mode": "static_colliders",
    "source_group_name": "formal_navigation_source",
    "baking_aabb_margin": 2.0,
    "baking_height_min": -1.0,
    "baking_height_max": 6.0,
    "baking_floor_depth": 0.2
