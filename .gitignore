# Godot 4+ specific ignores
.godot/
/android/

# Local backend secrets
backend/.env
backend/logs/

# Python cache
__pycache__/
*.py[cod]
.venv/

# Local editor paths
.vscode/settings.json
/.gitignore copy

# Generated logs and visual QA captures
*.log
/artifacts/
/nothing.avi

# Third-party art intake (local source copies; tracked manifests and licenses stay outside these paths)
/art_source/downloads/*
!/art_source/downloads/README.md
/art_source/quaternius/*/
/art_source/working/*
!/art_source/working/README.md
/art_source/runtime_rejected/
/art_source/licenses/source_pages/
/art_source/synty/
/art_source/kaykit/
