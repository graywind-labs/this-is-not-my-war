		{
			"listener_id": "cook_01",
			"listener_name": "布鲁诺",
			"speaker_id": "guard_officer",
			"speaker_name": "守备官",
			"text": "布鲁诺，我征召你入伍，不是让你拿菜刀冲锋。食堂仍归你管，警铃响起就到内院支援，受伤的人还得吃你做的热饭。守不住这里，锅和粮食都会落进敌人手里。你愿意和我们一起把自己的食堂守住吗？",
			"visibility": "private"
		},
		{
			"emotion_emoji": "✊",
			"emotion_id": "determined",
			"emotion_label": "坚定",
			"listener_id": "guard_officer",
			"listener_name": "守备官",
			"recruitment_result": "reject",
			"speaker_id": "cook_01",
			"speaker_name": "布鲁诺",
			"text": "守备官，这话说得实在——食堂归我管，伤员的热饭我照做。可我得问一句：我应征之后，警铃一响我去内院，灶上那锅汤谁看着？总得有人替我盯火，不然前线的人回来连口热的都吃不上。",
			"visibility": "private"
		}
	],
