  "dialogue": {
    "avoid_combat": {
      "none": {
        "debug_reason": "伊沃如实回答守备官询问，符合其安静细致的性格和当前避敌状态。",
        "emotion": "calm",
        "intent": "continue_talk",
        "recruitment_result": "none",
        "reply_text": "宿舍里只有我一个人，守备官。没人受伤，我按你说的待在墙角，没靠近窗户。",
        "should_end_dialogue": false,
        "wartime_reaction": "none"
